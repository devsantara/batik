{
  "name": "batik",
  "version": "0.0.0",
  "private": true,
  "description": "Token-first design system for StyleX",
  "keywords": [
    "design system",
    "stylex"
  ],
  "homepage": "https://github.com/devsantara/batik#readme",
  "bugs": {
    "url": "https://github.com/devsantara/batik/issues"
  },
  "license": "MIT",
  "author": "devsantara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devsantara/batik.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "build": "vp run -r build",
    "dev": "vp run -r dev",
    "start": "vp run -r start",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
